# lan-file-hub 环境变量示例
#
# 用法：复制为 .env 后按需修改。.env 已在 .gitignore 中，绝不会进仓库。
#   Copy-Item .env.example .env
#
# 优先级：进程环境变量 > .env 文件 > 代码内默认值。
# 本文件里的口令只用于本机开发；生产环境启动时会拒绝开发默认口令（见下）。

# ---- 运行环境 ----
APP_ENV=development
HTTP_PORT=8080
HTTP_THREADS=4
LOG_LEVEL=info
# 留空 = 只输出到控制台；填写则同时写入滚动文件
LOG_FILE=
# 前端静态文件目录（五阶段改造 ④：便携包单端口形态）
# 留空 = 后端只提供 API（开发用 vite、生产用 nginx）
# 填写（例如 web）= 后端直接托管前端 dist，前端路由回退到 index.html，
#   这样便携包**不需要 Node.js / nginx**，只有一个端口一个进程
WEB_ROOT=

# ---- 配套手机应用（安卓安装包，2026-10-03）----
# 网页「我的」→「配套手机应用」的下载来源。留空 = 跟着 WEB_ROOT 走
# （<WEB_ROOT>/downloads/lan-file-hub.apk，便携包默认就是这样）。
# scripts\build-android.ps1 出包后会自动同步到这个位置并写 lan-file-hub.apk.json 侧车，
# 接口每次请求现看文件，所以重新出包后刷新网页即可，不用重启后端。
APP_APK_PATH=

# ---- 注册策略（2026-10-02）----
# true（默认）= 任何人都能自助注册（个人自用方便）
# false        = 关闭自助注册，只有拿到管理员邀请链接的人才能注册（公司/对外场景）
#   关闭后：注册页会提示"需要邀请"，管理员在「系统管理 → 邀请」里生成链接/二维码
ALLOW_SELF_REGISTRATION=true

# ---- 数据库 ----
# 与 docker-compose.yml 中的 postgres 服务对应。
# 开发默认口令：lan_file_hub_dev（仅限本机；生产环境使用它会拒绝启动）
DATABASE_URL=postgresql://lan_file_hub:lan_file_hub_dev@127.0.0.1:5432/lan_file_hub
DATABASE_CONNECT_TIMEOUT_MS=3000

# ---- 缓存 ----
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT_MS=2000

# ---- 对象存储 ----
# 相对路径按启动时的工作目录解析，启动时会规范化为绝对路径
STORAGE_ROOT=./storage

# ---- 传输限制 ----
# 默认分块 8 MiB，允许区间 1 MiB ~ 64 MiB
DEFAULT_CHUNK_SIZE=8388608
# 单文件上限 10 GiB
MAX_FILE_SIZE=10737418240
# 全局并发上传数
MAX_CONCURRENT_UPLOADS=16
# 单用户默认配额 20 GiB
# 无论何时都要保留的磁盘可用空间（字节，默认 1 GiB）：低于它就拒绝新的上传
# 限流（阶段十二）：窗口都是 1 分钟
LOGIN_RATE_LIMIT_PER_MINUTE=10
LOGIN_IP_RATE_LIMIT_PER_MINUTE=60
UPLOAD_RATE_LIMIT_PER_MINUTE=120
# 分享密码解锁（2026-10-03）：同一 IP + 同一条分享每分钟允许试几次（1~600），挡住暴力猜密码
SHARE_UNLOCK_RATE_LIMIT_PER_MINUTE=10

MIN_FREE_DISK_BYTES=1073741824

MAX_USER_STORAGE_BYTES=21474836480
# 上传会话有效期（秒），默认 24 小时
UPLOAD_SESSION_TTL=86400
# 下载限速（字节/秒），0 = 不限速；阶段十二实现
DOWNLOAD_RATE_LIMIT=0

# ---- 认证 ----
# 生产环境必须设置且不少于 32 个字符；开发环境可留空（会打印警告）
JWT_SECRET=
JWT_EXPIRE_SECONDS=3600
# 「记住我」勾上时的有效期（默认 30 天 = 2592000 秒；允许 1 小时 ~ 365 天）。
# 与前端 tokenStore 配合：勾了才把令牌放进 localStorage，手机上不用每次重登（用户 2026-10-03 要求）。
JWT_REMEMBER_EXPIRE_SECONDS=2592000

# ---- CORS ----
# 逗号分隔的明确白名单，禁止使用 *
CORS_ALLOWED_ORIGINS=http://localhost:5173
# ---- 容器编排与部署（阶段十五）----
# 仅本机开发用的默认口令；部署到任何共享环境前必须改掉，并且不要提交 .env
POSTGRES_USER=lan_file_hub
POSTGRES_PASSWORD=lan_file_hub_dev
POSTGRES_DB=lan_file_hub
POSTGRES_PORT=5432
REDIS_PORT=6379
FRONTEND_PORT=5173

# 初始化第一个管理员（docker compose --profile admin run --rm init-admin）
# 这两个值是**示例**，口令请换成长且唯一的字符串；工具只从环境变量读取，不落仓库
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=