<?xml version="1.0" encoding="utf-8"?>
<!-- 「连接电脑」页：当前网络 + 自动查找状态 + 历史地址列表 + 查找/添加/快传 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/connect_title"
      android:textSize="22sp"
      android:textStyle="bold" />

  <!-- 当前网络（WiFi / 手机热点 / 流量）：2026-10-03 用户要求"一眼看出连上没有" -->
  <TextView
      android:id="@+id/network_state"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:textSize="14sp"
      android:textStyle="bold" />

  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:text="@string/connect_subtitle"
      android:textSize="13sp" />

  <!-- 自动查找的进度/结果（"正在找电脑… 120/254" / "发现了 1 台电脑" / 为什么找不到） -->
  <TextView
      android:id="@+id/search_state"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:textSize="13sp" />

  <TextView
      android:id="@+id/empty_hint"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:gravity="center"
      android:text="@string/connect_empty"
      android:textSize="15sp"
      android:visibility="gone" />

  <ListView
      android:id="@+id/server_list"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_marginTop="12dp"
      android:layout_weight="1"
      android:divider="#22000000"
      android:dividerHeight="1dp" />

  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="@string/connect_footer"
      android:textSize="12sp" />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:orientation="horizontal">

    <Button
        android:id="@+id/find_server"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/connect_find_button" />

    <Button
        android:id="@+id/add_server"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:text="@string/connect_add_button" />
  </LinearLayout>

  <Button
      android:id="@+id/open_share"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="@string/connect_share_button" />

  <Button
      android:id="@+id/open_backup"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="@string/backup_entry_button" />
</LinearLayout>
