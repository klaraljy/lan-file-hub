# 反向代理示例（阶段十五第 16、17 条）。
#
# 用法：
#   1. 把证书放到 deploy/certs/（fullchain.pem / privkey.pem），或用你自己的路径；
#   2. 改 server_name 与证书路径；
#   3. 挂到你的反代容器里：
#        docker run -d --name lfh-proxy -p 80:80 -p 443:443 \
#          -v $PWD/deploy/nginx.conf.example:/etc/nginx/conf.d/default.conf:ro \
#          -v $PWD/deploy/certs:/etc/nginx/certs:ro \
#          --network <compose 网络> nginx:1.27-alpine
#
# 为什么需要这一层：
#   - 本服务不自建 TLS（docs/security.md §8），HTTPS 一律由反代终止；
#   - 后端按 X-Forwarded-For / X-Real-IP 做限流分维度，必须由反代提供这两个头；
#   - /metrics 不做认证，必须在这里限制来源，不能直接暴露到公网。

server {
    listen 80;
    server_name files.example.com;
    # ACME 校验放行，其余一律跳 HTTPS
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name files.example.com;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # 分块上传：单块最大 64 MiB（服务端上限），留一倍余量
    client_max_body_size 128m;
    # 大文件传输可能很久：别让反代先超时
    proxy_read_timeout    300s;
    proxy_send_timeout    300s;
    # 边收边转，避免反代把整块落到自己的临时目录
    proxy_request_buffering off;

    # 安全响应头由后端下发；这里补一层与站点有关的
    add_header X-Content-Type-Options nosniff always;

    location /api/ {
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health/live {
        proxy_pass http://backend:8080/health/live;
        access_log off;
    }

    # 指标端点不做认证：只给内网/监控来源
    location = /metrics {
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;
        proxy_pass http://backend:8080/metrics;
        access_log off;
    }

    location / {
        proxy_pass http://frontend:80;
        proxy_set_header Host $host;
    }
}
